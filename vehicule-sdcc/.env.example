# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="SDCC Réservation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Casablanca

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation-sdcc
DB_USERNAME=root
DB_PASSWORD=

# ── Super Admin (seeder) ────────────────────────────────────────────────────
# IMPORTANT: Change these values before running seeder in production!
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@your-domain.ma
SUPER_ADMIN_PASSWORD="ChangeMe@123456"
SUPER_ADMIN_SERVICE="Direction Generale"

# ── Cache / Session / Queue ──────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

# ── HR Excel ─────────────────────────────────────────────────────────────────
HR_EXCEL_DISK=local
HR_EXCEL_JSON_PATH=hr/main_requests.json
HR_EXCEL_FILE_PATH=hr/main_requests.xlsx
HR_EXCEL_DOWNLOAD_NAME=main_requests.xlsx

# ── Redis ────────────────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail Configuration ──────────────────────────────────────────────────────
# For LOCAL testing: use Mailtrap (https://mailtrap.io)
# For PRODUCTION:    use real SMTP (Gmail, Mailgun, SES, etc.)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@sdcc.ma"
MAIL_FROM_NAME="SDCC — Réservation Véhicule"

# ── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1:8000

# ── AWS (optional) ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Pusher (optional) ───────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
